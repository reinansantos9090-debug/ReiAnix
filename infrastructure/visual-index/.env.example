# DNS A/AAAA records must point this domain to the server.
REIANIX_INDEX_DOMAIN=visual-index.example.net

# Generate long random values on the host; never commit the real .env.
# Example: openssl rand -hex 32
TRACE_API_SALT=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MINIO_ACCESS_KEY=reianix-minio
MINIO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Optional path for locally authorized reference videos if you build your own index.
VIDEO_PATH=./video
MAX_WORKER=2
SCAN_INTERVAL=0
