# Public OAuth client configuration. Do not add a client secret to a mobile app.
REIANIX_GOOGLE_CLIENT_ID=your-public-client-id.apps.googleusercontent.com
REIANIX_GOOGLE_REDIRECT_URL=https://your-authorized-redirect.example/callback
REIANIX_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
