<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Primary shared storage (downloads, movies, local anime folders). -->
    <external-path name="shared-videos" path="." />
    <!-- Removable SD cards under /storage/ are also scanned by the local library. -->
    <root-path name="sdcard-videos" path="storage/" />
    <cache-path name="cached-videos" path="video_exports/" />
</paths>
